fn int32 main1()
{
    int32 x = 125;
    bool y = false;

    return x / 125 + y;
}

fn int32 main2()
{
    int32 x = (125 * 2) + (1 + false);

    return x;
}

fn int32 main3()
{
    bool x = bool((23 + 17) / 4) + 1;
    bool x = 12;

    return int32(bool(int32(x) + 12) > bool(12));
}

fn int32 main4()
{
    bool x = 12;

    return x;
}

