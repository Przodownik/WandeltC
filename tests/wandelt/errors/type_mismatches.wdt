fn int main1()
{
    int x = 125;
    bool y = false;

    return x / 125 + y;
}

fn int main2()
{
    int x = (125 * 2) + (1 + false);

    return x;
}

fn int main3()
{
    bool x = bool((23 + 17) / 4) + 1;
    bool x = 12;

    return int(bool(int(x) + 12) > bool(12));
}

fn int main4()
{
    bool x = 12;

    return x;
}

