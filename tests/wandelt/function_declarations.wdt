fn int add(int x, int y = 12)
{
	return x + y;
}

fn int testfunc1()
{
    return 123;
}

fn int testfunc2()
{
    return 123 / 23 * 123 + 123 - 123 * 123 / 123;
}

fn int main()
{
    int a = 3400;

    return a;
}

<*
#expect
; ModuleID = 'module:core'
source_filename = "main.wdt"
target datalayout = ""
target triple = ""

define i32 @add(i32 %0, i32 %1) {
entry:
  %x = alloca i32, align 4
  store i32 %0, ptr %x, align 4
  %y = alloca i32, align 4
  store i32 %1, ptr %y, align 4
  %x1 = load i32, ptr %x, align 4
  %y2 = load i32, ptr %y, align 4
  %add = add i32 %x1, %y2
  ret i32 %add
}

define i32 @testfunc1() {
entry:
  ret i32 123
}

define i32 @testfunc2() {
entry:
  ret i32 615
}

define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 3400, ptr %a, align 4
  %a1 = load i32, ptr %a, align 4
  ret i32 %a1
}
*>
