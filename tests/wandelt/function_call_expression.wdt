fn int add(int x)
{
    return x * 2;
}

fn int main()
{
    int x = 12;
    
    return add(x + 8);
}

<*
#expect
; ModuleID = 'module:core'
source_filename = "main.wdt"
target datalayout = ""
target triple = ""

define i32 @add(i32 %0) {
entry:
  %x = alloca i32, align 4
  store i32 %0, ptr %x, align 4
  %x1 = load i32, ptr %x, align 4
  %mul = mul i32 %x1, 2
  ret i32 %mul
}

define i32 @main() {
entry:
  %x = alloca i32, align 4
  store i32 12, ptr %x, align 4
  %x1 = load i32, ptr %x, align 4
  %add = add i32 %x1, 8
  %add2 = call i32 @add(i32 %add)
  ret i32 %add2
}
*>
