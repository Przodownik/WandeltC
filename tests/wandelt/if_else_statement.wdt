fn int main()
{
    int x = 12;

    if (x > 15)
    {
        x = 12;
    }
    else
    {
        x = 28;

        if (x >= 20)
        {
            x = 30;
        }
        else
        {
            x = 40;
        }
    }

    return x;
}

