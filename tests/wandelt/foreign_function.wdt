fn int putchar(int) @foreign;

fn int main()
{
    int x = 30;

    while (x < 100) {
        putchar(x);
     
        x = x + 1;
    }

    putchar(10);

    x = 30;

    while (x < 100) {
        putchar(x);
     
        x = x + 1;
    }

    return 0;
}

