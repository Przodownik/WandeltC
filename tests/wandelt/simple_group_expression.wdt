fn int main()
{
    int a = 2500;

    return (a + a) * 4;
}

<*
#expect
; ModuleID = 'module:core'
source_filename = "main.wdt"
target datalayout = ""
target triple = ""

define i32 @main() {
entry:
  %a = alloca i32, align 4
  store i32 2500, ptr %a, align 4
  %a1 = load i32, ptr %a, align 4
  %a2 = load i32, ptr %a, align 4
  %add = add i32 %a1, %a2
  %mul = mul i32 %add, 4
  ret i32 %mul
}
*>
